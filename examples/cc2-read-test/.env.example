# Elegoo CC2 printer connection settings
# Copy this file to .env and fill in your printer's values

# Printer IP address on your LAN
PRINTER_HOST=192.168.1.100

# Printer model name (used for display only)
PRINTER_MODEL=Neptune 4 Pro

# Access code shown in the printer's touchscreen (Settings > Network)
PRINTER_ACCESS_CODE=12345678

# Serial number (optional, used as printer ID — find it on the printer label)
PRINTER_SERIAL=ELGOOPRO00000001
