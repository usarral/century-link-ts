{
  "name": "century-link-ts",
  "version": "0.1.0",
  "description": "TypeScript library for communicating with Elegoo 3D printers over LAN",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "elegoo",
    "3d-printer",
    "iot",
    "mqtt",
    "websocket"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "mqtt": "^5.10.4",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
