{
  "name": "@usarral/century-link-ts",
  "version": "0.3.1",
  "description": "TypeScript library for communicating with Elegoo 3D printers over LAN",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "elegoo",
    "3d-printer",
    "iot",
    "mqtt",
    "websocket"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usarral/century-link-ts.git"
  },
  "homepage": "https://github.com/usarral/century-link-ts#readme",
  "bugs": {
    "url": "https://github.com/usarral/century-link-ts/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "mqtt": "^5.10.4",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
